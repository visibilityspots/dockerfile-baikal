     /**
+     * Reads the calendar-timezone property.
+     *
+     * RFC 4791 says it holds a VCALENDAR with a single VTIMEZONE, but Home
+     * Assistant and Baikal's own admin store a plain name such as
+     * "Europe/Paris", which VObject cannot parse (sabre-io/dav#1318).
+     * Both forms are accepted.
+     */
+    private static function readCalendarTimeZone(string $value): DateTimeZone
+    {
+        if (false === strpos($value, 'BEGIN:VCALENDAR')) {
+            return new DateTimeZone(trim($value));
+        }
+
+        // This property contains a VCALENDAR with a single VTIMEZONE.
+        $vtimezoneObj = VObject\Reader::read($value);
+        $timeZone = $vtimezoneObj->VTIMEZONE->getTimeZone();
+
+        // Destroy circular references so PHP will garbage collect the object.
+        $vtimezoneObj->destroy();
+
+        return $timeZone;
+    }
+
